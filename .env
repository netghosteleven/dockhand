# Replace all REPLACE_WITH_* values before deploying.
# Keep this file out of Git. In Dockhand, paste these values into the stack
# environment editor instead of committing a secret-bearing .env file.

COMPOSE_PROJECT_NAME=honcho
HONCHO_IMAGE_TAG=local

# Generate separately with: openssl rand -hex 32
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_POSTGRES_PASSWORD
AUTH_USE_AUTH=true
AUTH_JWT_SECRET=REPLACE_WITH_64_HEX_JWT_SECRET

# Create a dedicated OpenAI Platform project/key for Honcho.
LLM_OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY

LOG_LEVEL=INFO
PERFORMANCE_LOG_FORMAT=compact
CORS_ORIGINS=[]
TELEMETRY_ENABLED=false

# Low-volume personal deployment profile.
EMBED_MESSAGES=false
EMBEDDING_VECTOR_DIMENSIONS=1536
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=text-embedding-3-small

DERIVER_ENABLED=true
DERIVER_WORKERS=1
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=gpt-5.4-mini
DERIVER_MODEL_CONFIG__THINKING_EFFORT=minimal
DERIVER_REPRESENTATION_BATCH_WORK_UNIT_TARGET_TOKENS=1024
DERIVER_REPRESENTATION_BATCH_TARGET_INPUT_TOKENS=2048
DERIVER_REPRESENTATION_BATCH_MAX_AGE_SECONDS=1800
DERIVER_FLUSH_ENABLED=false

PEER_CARD_ENABLED=true
SUMMARY_ENABLED=false
DREAM_ENABLED=false

DIALECTIC_MAX_OUTPUT_TOKENS=512
DIALECTIC_MAX_INPUT_TOKENS=25000
DIALECTIC_HISTORY_TOKEN_LIMIT=4096
DIALECTIC_SESSION_HISTORY_MAX_TOKENS=2048
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=gpt-5.4-mini
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__THINKING_EFFORT=minimal
DIALECTIC_LEVELS__minimal__MAX_TOOL_ITERATIONS=1
DIALECTIC_LEVELS__minimal__MAX_OUTPUT_TOKENS=250
